{
  "compilerOptions": {
    "target": "es2017",
    "module": "esnext",
    "lib": ["ES2016","DOM","ES2019"],
    "types": ["node"],
    "moduleResolution": "bundler",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": false,
    "skipLibCheck": true
  }
}
