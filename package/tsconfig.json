{
  "compilerOptions": {
    "target": "es2020",
    "module": "es2022",
    "lib": ["ES6","ES2022"],
    "moduleResolution": "bundler",
    "outDir": "./dist",
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": false,
    "skipLibCheck": true
  }
}